<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Recherche de contacts depuis la barre de recherche -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Recherche de fichiers depuis la barre de recherche -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Dictée vers Claude -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Ouvrir le volet de notifications par geste -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Désinstaller une app depuis l'appui long -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Espace privé (Android 15+) : visible pour le launcher par défaut qui déclare cette permission -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!-- Un launcher doit voir toutes les apps, packs d'icônes et widgets -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nimbus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dictée vers Claude : écran transparent par-dessus l'appli en cours -->
        <activity
            android:name=".dictation.DictationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="fr.perso.nimbus.dictation"
            android:theme="@style/Theme.Nimbus.Dictation"
            android:windowSoftInputMode="adjustResize" />

        <!-- Démarre le service « micro » puis ouvre le panneau flottant ; invisible -->
        <activity
            android:name=".dictation.DictationStarterActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="fr.perso.nimbus.dictation"
            android:theme="@style/Theme.Nimbus.Invisible" />

        <!-- Micro pendant que le panneau de dictée est ouvert -->
        <service
            android:name=".service.DictationMicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Bulle de dictée et envoi dans l'appli Claude -->
        <service
            android:name=".service.DictationService"
            android:exported="true"
            android:label="@string/dictation_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dictation_service" />
        </service>

        <!-- Tuile des réglages rapides « Dictée Claude » -->
        <service
            android:name=".service.DictationTileService"
            android:exported="true"
            android:icon="@drawable/ms_mic"
            android:label="@string/dictation_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Pastilles de notification sur les icônes -->
        <service
            android:name=".service.BadgeService"
            android:exported="true"
            android:label="@string/badge_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Verrouillage par double tap + ouverture des notifications -->
        <service
            android:name=".service.GestureService"
            android:exported="true"
            android:label="@string/gesture_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>
</manifest>
